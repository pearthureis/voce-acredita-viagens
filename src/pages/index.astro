---
import { getCollection } from 'astro:content';
import { formatDatePtBR } from '../lib/format';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ShopCTA from '../components/ShopCTA.astro';
const videoFiles = import.meta.glob('../videos/*.{webm,mp4,mov}', {
  eager: true,
  query: '?url',
  import: 'default',
}) as Record<string, string>;

function videoSrc(stem: string) {
  const order = ['webm', 'mp4', 'mov'] as const;
  for (const ext of order) {
    const match = Object.entries(videoFiles).find(([file]) =>
      file.replace(/\\/g, '/').endsWith(`/${stem}.${ext}`),
    );
    if (match) return match[1];
  }
  throw new Error(`Vídeo não encontrado: ${stem}`);
}

const videoCastle = videoSrc('Manter_vídeo_castelo_fogos_1080p_20261018124903');
const videoWhale = videoSrc('Orca_breaching_animation_sequence_1080p_20261018125016');
const videoGlobe = videoSrc('universal');

const shopUrl = 'https://voceacreditaviagensv2.justtraveltour.com/pt';
const waUrl = 'https://wa.me/5511994584598';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const orlando = {
  title: 'Orlando',
  text: 'A capital da magia: resorts, gastronomia e dias inesquecíveis em família.',
};

const parkScenes = [
  {
    kind: 'castle',
    title: 'Disney',
    text: 'Magic Kingdom, EPCOT, Hollywood Studios e Animal Kingdom com roteiro sob medida.',
    video: videoCastle,
    label: 'Castelo com fogos no Magic Kingdom',
  },
  {
    kind: 'globe',
    title: 'Universal',
    text: 'Todos os parques roterizados para que consiga conhecer todos!.',
    video: videoGlobe,
    label: 'Globo da Universal Studios',
  },
  {
    kind: 'whale',
    title: 'E mais...',
    text: 'Muitos outros parques e atrações nos EUA.',
    video: videoWhale,
    label: 'Baleia saltando na água',
  },
];

const steps = [
  {
    n: '1',
    title: 'Me conte o seu sonho',
    text: 'Quem vai? Quanto tempo? E tudo que não pode faltar na sua viagem! ',
  },
  {
    n: '2',
    title: 'Planejamos juntos',
    text: 'Hotéis, ingressos, transfers e dicas de quem realmente conhece. Tudo alinhado com você!',
  },
  {
    n: '3',
    title: 'Reserve na loja',
    text: 'Checkout seguro na Loja Virtual.',
  },
];

const services = [
  {
    title: 'Roteiro personalizado',
    text: 'Dias organizados por parque, ritmo da família e prioridades.',
  },
  {
    title: 'Concierge de viagem',
    text: 'Orientação antes e durante a viagem para você aproveitar sem stress.',
  },
  {
    title: 'Grupos e celebrações',
    text: 'Aniversários, lua de mel e viagens em grupo com atenção especial.',
  },
];
---

<BaseLayout
  title="Você Acredita Viagens"
  description="Experiências mágicas, memórias eternas. Landing e blog da Você Acredita Viagens - especialistas em Orlando."
>
  <Header slot="header" />

  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Você Acredita?</p>
        <h1>Experiências mágicas,<br />memórias eternas</h1>
        <p class="hero-lead">
          Especialistas em Orlando. Planejamos sua viagem dos sonhos
          e você reserva com segurança na nossa loja online.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={shopUrl} target="_blank" rel="noopener noreferrer">
            Ir à loja
          </a>
          <a class="btn btn-outline hero-outline" href="/contato">Falar conosco</a>
          <a class="btn btn-outline hero-outline" href="/blog">Blog</a>
        </div>
      </div>
      <div class="hero-visual">
        <img
          src="/brand/logo-on-red.jpg"
          alt="Logo Você Acredita Viagens"
          width="480"
          height="480"
          class="hero-logo"
        />
      </div>
    </div>
  </section>

  <section class="section" id="parques" aria-labelledby="parques-title">
    <div class="container">
      <p class="eyebrow" style="display:block;text-align:center">Destinos</p>
      <h2 class="section-title" id="parques-title">Foco em Orlando e parques</h2>
      <p class="section-lead">
        Magia, adrenalina e memórias em família. Com planejamento cuidadoso do início ao fim!
      </p>
      <article class="card park-orlando">
        <h3>{orlando.title}</h3>
        <p>{orlando.text}</p>
      </article>
    </div>
    <div class="park-scenes">
      {
        parkScenes.map((scene) => (
          <article class="park-scene" data-park-scene data-kind={scene.kind}>
            <div class="park-scene-pin">
              <div class="container park-scene-layout">
                <div class="park-scene-frame">
                  <video
                    class="park-scene-video"
                    data-src={scene.video}
                    muted
                    playsinline
                    preload="none"
                    disablepictureinpicture
                    aria-hidden="true"
                    tabindex="-1"
                  />
                  <span class="visually-hidden">{scene.label}</span>
                </div>
                <div class="park-scene-copy">
                  <h3>{scene.title}</h3>
                  <p>{scene.text}</p>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section-alt" id="como-funciona" aria-labelledby="como-title">
    <div class="container">
      <p class="eyebrow" style="display:block;text-align:center">Simples assim</p>
      <h2 class="section-title" id="como-title">Como funciona</h2>
      <p class="section-lead">Três passos para transformar o sonho em viagem.</p>
      <div class="card-grid cols-3">
        {
          steps.map((step) => (
            <article class="card step-card">
              <span class="step-n">{step.n}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="servicos" aria-labelledby="servicos-title">
    <div class="container">
      <p class="eyebrow" style="display:block;text-align:center">Serviços</p>
      <h2 class="section-title" id="servicos-title">Como podemos te ajudar</h2>
      <p class="section-lead">
        Atendimento humano no WhatsApp.
      </p>
      <div class="card service-box">
        {
          services.map((svc) => (
            <div class="service-item">
              <h3>{svc.title}</h3>
              <p>{svc.text}</p>
            </div>
          ))
        }
        <div class="services-cta">
          <a class="btn btn-primary" href={waUrl} target="_blank" rel="noopener noreferrer">
            Falar no WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="sobre" aria-labelledby="sobre-title">
    <div class="container about-grid">
      <div class="about-visual">
        <img
          src="/brand/ellen-reis.jpg"
          alt="Ellen Reis, fundadora da Você Acredita Viagens, em Orlando"
          width="1200"
          height="1600"
          class="about-photo"
          loading="lazy"
        />
      </div>
      <div>
        <p class="eyebrow">Sobre</p>
        <h2 id="sobre-title">Ellen Reis</h2>
        <p>
          Fundadora da Você Acredita Viagens, acredito que cada viagem é uma história
          mágica! Desejo que todos possam um dia experenciar essa magia, e espero facilitar 
          isso para que tenha um momento inesquecícel!
        </p>
        <p>
          O nome da marca é um convite: <strong class="script" style="font-size:1.4rem;color:var(--coral)"
            >Você Acredita?</strong
          >
        </p>
        <a class="btn btn-primary" href={waUrl} target="_blank" rel="noopener noreferrer">
          Conversar com a Ellen
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="blog" aria-labelledby="blog-title">
    <div class="container">
      <p class="eyebrow" style="display:block;text-align:center">Blog</p>
      <h2 class="section-title" id="blog-title">Dicas e inspirações</h2>
      <p class="section-lead">Conteúdo para planejar melhor a sua próxima aventura.</p>
      <div class="card-grid cols-3">
        {
          posts.map((post) => (
            <article class="card post-card">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDatePtBR(post.data.pubDate)}
              </time>
              <h3>
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
              <a href={`/blog/${post.id}`}>Ler post →</a>
            </article>
          ))
        }
      </div>
      <p class="blog-more">
        <a class="btn btn-outline" href="/blog">Ver todos os posts</a>
      </p>
    </div>
  </section>

  <ShopCTA />
  <Footer slot="footer" />
</BaseLayout>

<script>
  import { initParkScroll } from '../scripts/park-scroll';
  initParkScroll();
</script>

<style>
  .hero {
    background: var(--hero-bg);
    color: var(--hero-ink);
    padding: 3.5rem 0 4rem;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .hero h1 {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    color: var(--hero-ink);
    margin-bottom: 1rem;
  }

  .hero .eyebrow {
    color: var(--hero-accent);
    font-size: 2rem;
  }

  .hero-lead {
    font-size: 1.05rem;
    opacity: 0.95;
    max-width: 34rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .hero-outline {
    color: var(--hero-accent);
    border-color: var(--hero-accent);
  }

  .hero-outline:hover {
    background: var(--hero-outline-hover);
    color: var(--hero-accent);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .hero-logo {
    width: min(100%, 380px);
    border-radius: 24px;
    box-shadow: var(--hero-logo-shadow);
  }

  .park-orlando {
    max-width: 36rem;
    margin: 0 auto 1.5rem;
    text-align: center;
  }

  .park-orlando h3,
  .park-scene-copy h3,
  .step-card h3,
  .service-card h3,
  .post-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }

  .park-orlando p,
  .park-scene-copy p,
  .step-card p,
  .service-card p,
  .post-card p {
    color: var(--ink-muted);
    font-size: 0.95rem;
    margin-bottom: 0.85rem;
  }

  .park-scenes {
    display: flex;
    flex-direction: column;
  }

  .park-scene-pin {
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
    padding: 1.25rem 0;
  }

  .park-scene-layout {
    display: grid;
    gap: 1.15rem;
    align-items: center;
    width: min(100% - 2rem, var(--max));
  }

  .park-scene-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: transparent;
  }

  .park-scene-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    background: transparent;
    pointer-events: none;
  }

  .park-scene-copy {
    text-align: center;
    justify-self: center;
  }

  .park-scene-copy h3 {
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  .park-scene-copy p {
    margin-bottom: 0;
    max-width: 36rem;
  }

  @media (max-width: 899px) {
    .park-scene-pin {
      min-height: auto;
      padding: 1.75rem 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .park-scene-pin {
      min-height: auto;
    }
  }

  .step-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--step-bg);
    color: var(--step-ink);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .service-box {
    max-width: 760px;
    margin-inline: auto;
    display: grid;
    gap: 1.5rem;
  }

  .service-item + .service-item {
    border-top: 1px solid var(--border-soft);
    padding-top: 1.5rem;
  }

  .service-item h3 {
    margin-bottom: 0.35rem;
  }

  .service-item p {
    margin: 0;
  }

  .services-cta {
    display: flex;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .about-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 800px) {
    .about-grid {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }

  .about-photo {
    width: min(100%, 360px);
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 20%;
    margin-inline: auto;
    display: block;
    border-radius: 24px;
    box-shadow: var(--shadow);
  }

  .post-card time {
    font-size: 0.8rem;
    color: var(--coral);
    font-weight: 700;
  }

  .post-card h3 a {
    text-decoration: none;
    color: var(--ink);
  }

  .post-card h3 a:hover {
    color: var(--accent);
  }

  .blog-more {
    text-align: center;
    margin-top: 2rem;
  }
</style>
