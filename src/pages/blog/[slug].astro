---
import { getCollection, render } from 'astro:content';
import { formatDatePtBR } from '../../lib/format';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ShopCTA from '../../components/ShopCTA.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <Header slot="header" />

  <article class="post">
    <header class="page-hero">
      <div class="container narrow">
        <p class="eyebrow">Blog</p>
        <h1>{post.data.title}</h1>
        <p class="meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {
              formatDatePtBR(post.data.pubDate)
            }
          </time>
          <span aria-hidden="true">·</span>
          <span>{post.data.author}</span>
        </p>
        {
          post.data.tags?.length ? (
            <ul class="tags">
              {post.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          ) : null
        }
      </div>
    </header>

    <div class="container narrow prose">
      <Content />
    </div>

    <div class="container narrow">
      <ShopCTA compact />
      <p class="back">
        <a href="/blog">← Voltar ao blog</a>
      </p>
    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .page-hero {
    background: var(--bg-soft);
    padding: 3rem 0 2rem;
    border-bottom: 1px solid rgba(253, 172, 171, 0.45);
  }

  .narrow {
    max-width: 720px;
  }

  h1 {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    margin-bottom: 0.75rem;
  }

  .meta {
    color: var(--ink-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
  }

  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tags li {
    background: var(--white);
    color: var(--red);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(253, 172, 171, 0.7);
  }

  .prose {
    padding: 2.5rem 0 1rem;
  }

  .prose :global(h2) {
    font-size: 1.35rem;
    margin-top: 2rem;
    color: var(--red);
  }

  .prose :global(h3) {
    font-size: 1.15rem;
    margin-top: 1.5rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
    color: var(--ink-muted);
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(a) {
    font-weight: 700;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid rgba(253, 172, 171, 0.6);
    margin: 2rem 0;
  }

  .back {
    margin: 1.5rem 0 3rem;
  }

  .back a {
    font-weight: 700;
    text-decoration: none;
  }
</style>
